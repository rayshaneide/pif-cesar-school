#include <stdio.h>
#include <stdlib.h>
#include <math.h>
#define PI 3.14159265

int main() {
    double r, v,a;
    printf("Digite o valor do raio: ");
    scanf("%lf", &r);
    a = 4 * PI * pow(r, 2);
    v = (4.0/3.0)  * PI * pow (r,3);
    printf("A área da superfície da esfera é: %.3lf\n",a);
    printf("O volume da esfera é: %.3lf\n",v);
    system("pause");
    return 0;
}
