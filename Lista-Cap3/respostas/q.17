#include <stdio.h>

int main() {
    float nota, maior, menor, soma = 0.0, media;
    int quantidade = 0;

    printf("Digite uma nota de 0.0 a 10.0 ou -1.0 para parar: ");
    scanf("%f", &nota);

    while (nota != -1.0) {
        if (nota >= 0.0 && nota <= 10.0) {
            if (quantidade == 0) {
                maior = nota;
                menor = nota;
            } else {
                if (nota > maior) {
                    maior = nota;
                }

                if (nota < menor) {
                    menor = nota;
                }
            }

            soma += nota;
            quantidade++;
        } else {
            printf("Nota invalida.\n");
        }

        printf("Digite uma nota de 0.0 a 10.0 ou -1.0 para parar: ");
        scanf("%f", &nota);
    }

    if (quantidade > 0) {
        media = soma / quantidade;

        printf("Total de alunos avaliados: %d\n", quantidade);
        printf("Maior nota: %.2f\n", maior);
        printf("Menor nota: %.2f\n", menor);
        printf("Media geral: %.2f\n", media);
    } else {
        printf("Nenhum aluno foi avaliado.\n");
    }

    return 0;
}