#include <stdio.h>

int main() {
    int a, b, numero, i;
    int divisores;
    int soma = 0;

    printf("Digite A: ");
    scanf("%d", &a);

    printf("Digite B: ");
    scanf("%d", &b);

    if (a <= 0 || b <= 0 || a >= b) {
        printf("Valores invalidos. A e B devem ser positivos e A deve ser menor que B.\n");
    } else {
        printf("Primos no intervalo:\n");

        for (numero = a; numero <= b; numero++) {
            divisores = 0;

            for (i = 1; i <= numero; i++) {
                if (numero % i == 0) {
                    divisores++;
                }
            }

            if (numero > 1 && divisores == 2) {
                printf("%d ", numero);
                soma += numero;
            }
        }

        printf("\nSoma dos primos: %d\n", soma);
    }

    return 0;
}