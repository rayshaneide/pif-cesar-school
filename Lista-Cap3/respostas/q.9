#include <stdio.h>

int main() {
    float valor, soma = 0.0, media;
    int quantidade = 0;

    printf("Digite valores positivos. Digite um valor negativo para parar.\n");

    printf("Valor: ");
    scanf("%f", &valor);

    while (valor >= 0.0) {
        soma += valor;
        quantidade++;

        printf("Valor: ");
        scanf("%f", &valor);
    }

    if (quantidade > 0) {
        media = soma / quantidade;
        printf("Quantidade de valores validos: %d\n", quantidade);
        printf("Soma total: %.2f\n", soma);
        printf("Media: %.2f\n", media);
    } else {
        printf("Nenhum valor valido foi digitado.\n");
    }

    return 0;
}