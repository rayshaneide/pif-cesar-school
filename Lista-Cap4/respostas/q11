#include <stdio.h>

int main() {
    int a, b, c, auxiliar;

    printf("Digite tres numeros: ");
    scanf("%d %d %d", &a, &b, &c);

    if (a > b) {
        auxiliar = a;
        a = b;
        b = auxiliar;
    }

    if (a > c) {
        auxiliar = a;
        a = c;
        c = auxiliar;
    }

    if (b > c) {
        auxiliar = b;
        b = c;
        c = auxiliar;
    }

    printf("Ordem crescente: %d %d %d\n", a, b, c);

    return 0;
}
