#include <stdio.h>

int main() {
    float valor, imposto, total;
    int estado;

    printf("Digite o valor do produto: ");
    scanf("%f", &valor);

    printf("1 - MG\n");
    printf("2 - SP\n");
    printf("3 - RJ\n");
    printf("4 - MS\n");

    printf("Escolha o estado: ");
    scanf("%d", &estado);

    switch (estado) {
        case 1:
            imposto = 0.07;
            break;
        case 2:
            imposto = 0.12;
            break;
        case 3:
            imposto = 0.15;
            break;
        case 4:
            imposto = 0.08;
            break;
        default:
            printf("Estado invalido!\n");
            return 0;
    }

    total = valor + valor * imposto;

    printf("Valor final: R$ %.2f\n", total);

    return 0;
}